global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'switch_name', 'instance', 'ifIndex']
  group_wait: 30s
  group_interval: 1m
  repeat_interval: 12h
  receiver: 'telegram'

receivers:
  - name: 'telegram'
    telegram_configs:
      - bot_token: "{{ telegram_token }}"
        chat_id: {{ telegram_chat_id }}
        send_resolved: true
